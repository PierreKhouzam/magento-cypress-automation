{
    "name": "magento-cypress-automation",
    "version": "1.0.0",
    "description": "Cypress automation project for Magento website",
    "main": "index.js",
    "scripts": {
        "test": "cypress run --headless",
        "test:headed": "cypress run --headed",
        "flaky": "node cypress/scripts/flaky-cli.js",
        "test:flaky": "npm run test && npm run flaky",
        "merge-reports": "mochawesome-merge cypress/reports/.jsons/*.json > cypress/reports/merged-report.json",
        "generate-html-report": "marge cypress/reports/merged-report.json -f report -o cypress/reports/html"
    },
    "author": "Pierre Khouzam",
    "license": "ISC",
    "dependencies": {
        "decision-tree": "^0.3.7",
        "ml-cart": "^2.1.1",
        "winston": "^3.8.2"
    },
    "devDependencies": {
        "cypress": "^14.3.1",
        "cypress-mochawesome-reporter": "^3.8.2",
        "cypress-real-events": "^1.14.0",
        "cypress-wait-until": "^3.0.2",
        "mochawesome": "^7.1.3",
        "mochawesome-merge": "^4.2.1",
        "mochawesome-report-generator": "^6.2.0"
    }
}
