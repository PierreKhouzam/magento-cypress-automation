```gitignore

# Node modules
node_modules/

# Cypress screenshots and videos
cypress/screenshots/
cypress/videos/
cypress/downloads/
cypress/reports/

# System files
.DS_Store
__MACOSX/

# Env or sensitive config (optional)
.env
cypress.env.json

# IDE configs
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
